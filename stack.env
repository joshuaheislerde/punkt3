NUXT_PUBLIC_SITE_NAME=PUNKT3 Starter
NUXT_PUBLIC_SITE_DESCRIPTION=Your go-to starter template for building modern web applications.
NUXT_NODE_ENV=production
NUXT_HOST=0.0.0.0
NUXT_PORT=3000
NUXT_PUBLIC_API_URL=
NUXT_PUBLIC_SITE_URL=
# Available adapters: directus (supabase, nuxt_content - coming soon)
NUXT_BACKEND_ADAPTER=directus
# Umami analytics (optional, see deploy/umami). Leave empty to disable tracking.
NUXT_PUBLIC_UMAMI_HOST=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=
# comma-separated hostnames to track, e.g. joshuaheisler.de,www.joshuaheisler.de
NUXT_PUBLIC_UMAMI_DOMAINS=
